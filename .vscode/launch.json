{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent Eval: Run and Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build AgentEval",
      "program": "${workspaceFolder}/bin/Debug/net11.0/AgentEval.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5287"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
